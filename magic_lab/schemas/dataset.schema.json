{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/rl-observatory/dataset.schema.json",
  "title": "RL Observatory dataset v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "runs",
    "metrics",
    "points",
    "artifacts",
    "campaigns"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "runs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/run"
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metric"
      },
      "minItems": 1
    },
    "points": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/point"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "campaigns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/campaign"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "run": {
      "type": "object",
      "required": [
        "id",
        "status",
        "algorithm",
        "environment",
        "seed",
        "config",
        "code"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["completed", "running", "failed", "queued"]
        },
        "algorithm": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer"
        },
        "config": {
          "type": "object"
        },
        "code": {
          "type": "object",
          "required": ["commit", "dirty"],
          "properties": {
            "commit": {
              "type": "string",
              "minLength": 1
            },
            "dirty": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Shared experiment name across seed replicas; id remains unique per run."
        }
      },
      "additionalProperties": true
    },
    "metric": {
      "type": "object",
      "required": ["id", "label", "phase", "unit", "xUnit", "direction"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "enum": ["training", "evaluation"]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "xUnit": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": ["higher", "lower", "neutral"]
        }
      },
      "additionalProperties": true
    },
    "point": {
      "type": "object",
      "required": ["runId", "metricId", "step", "value"],
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "metricId": {
          "type": "string",
          "minLength": 1
        },
        "step": {
          "type": "number",
          "minimum": 0
        },
        "value": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "artifact": {
      "type": "object",
      "required": ["id", "runId", "kind", "label", "path"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["checkpoint", "video", "image", "file"]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Repository-relative reference; never automatically fetched"
        }
      },
      "additionalProperties": true
    },
    "variant": {
      "type": "object",
      "required": ["name", "algorithm", "parameters", "ablation", "command"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "algorithm": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        },
        "ablation": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "allOf": [
            {
              "pattern": "\\{seed\\}"
            },
            {
              "pattern": "\\{environment\\}"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "campaign": {
      "type": "object",
      "required": [
        "id",
        "title",
        "hypothesis",
        "status",
        "seeds",
        "environments",
        "variants"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "proposed",
            "approved",
            "in_progress",
            "completed",
            "cancelled"
          ]
        },
        "seeds": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variant"
          },
          "minItems": 1
        }
      },
      "additionalProperties": true
    }
  }
}
