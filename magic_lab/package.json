{
  "name": "rl-research-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local, agent-adaptable reinforcement learning research dashboard",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-code.mjs && prettier --check .",
    "check:data": "node scripts/validate.mjs",
    "format": "prettier --write .",
    "package:check": "node scripts/package.mjs --check",
    "package": "node scripts/package.mjs",
    "examples:generate": "node examples/magicplot/generate.mjs && node examples/magicalgo/ppo-document.mjs && prettier --write examples/magicplot/manifest.json examples/magicplot/runs examples/magicalgo/algorithms.json"
  },
  "dependencies": {
    "katex": "0.19.0",
    "plotly.js-dist-min": "4.1.2"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  },
  "files": [
    "core/",
    "reporting/",
    "panels/",
    "web/",
    "server/",
    "server.mjs",
    "adapters/",
    "schemas/",
    "scripts/",
    "tests/",
    "docs/",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "package-lock.json",
    ".prettierignore",
    ".github/",
    "examples/"
  ]
}
